{
  "name": "digi-cyber",
  "productName": "Digi Cyber",
  "version": "1.0.1",
  "description": "Digi Cyber VPN",
  "author": "Digi Cyber",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --arm64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --x64 --publish never && electron-builder --mac --arm64 --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource-variable/estedad": "^5.3.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "d3-geo": "^3.1.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "flag-icons": "^7.6.0",
    "i18n-iso-countries": "^7.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "windows-iana": "^5.1.0",
    "world-atlas": "^2.0.2"
  },
  "desktopName": "digi-cyber.desktop",
  "homepage": "https://digicyber.invalid"
}
